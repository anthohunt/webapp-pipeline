# Réglages de webapp-pipeline : copier en .env (non suivi par git), adapter, puis `set -a; . ./.env; set +a`.
# Toutes les valeurs ci-dessous sont des exemples.

# ── Emplacements
WEBAPP_PIPELINE_HOME=/opt/webapp-pipeline          # ce dépôt
FLUX_HOME=/opt/webapp-pipeline/vendor/flux         # le moteur flux (dépendance, voir le README)

# ── Ce que le moteur flux lit pour jouer cette pipeline
FLUX_WORKFLOWS_DIR=/opt/webapp-pipeline/workflows  # les graphes webapp.json et webapp-design.json
FLUX_SKILLS_DIR=/opt/webapp-pipeline/skills        # les consignes injectées aux agents
FLUX_VALIDATORS_PATH=/opt/webapp-pipeline/validators   # les contrôles de fin d'étape
# FLUX_STATE_DIR=/var/lib/flux/state               # état du moteur (défaut : <FLUX_HOME>/state)

# ── Runs
# WEBAPP_RUNS=/home/utilisateur/webapp-runs        # défaut : workspace_root du graphe (~/webapp-runs)

# ── Agents
# WEBAPP_MOTEUR=principal                          # id d'un moteur de moteurs.json (défaut : son `defaut`)
# WEBAPP_LIMITEUR=nice -n 10                       # préfixe des commandes lourdes (facultatif)

# ── Pile des applis construites (Supabase + Vercel) : fichier HORS dépôt, lisible par le seul utilisateur du moteur.
# Il contient SUPABASE_ACCESS_TOKEN=… et VERCEL_TOKEN=… ; ne jamais le mettre dans un dépôt.
WEBAPP_STACK_ENV=/etc/webapp-pipeline/stack.env

# ── Publication de la maquette pour le test du client (tools/publier-design.sh)
DESIGN_PUBLISH_DIR=/var/www/design                 # dossier servi en HTTP
PUBLIC_BASE_URL=https://maquettes.example.org/design

# ── Vidéo de démonstration (optionnelle) : outil de tournage externe, non fourni par ce dépôt
WEBAPP_VIDEO=0                                     # 0 = pas de vidéo ; 1 = tournage (exige les deux réglages suivants)
# TOURNAGE_MOD_HOME=/opt/tournage
# TOURNAGE_SKILL_HOME=/opt/tournage/scripts
# MONTAGE_URL=https://montage.example.org

# ── Accès distant (skill webapp-start, module Claude Code hors du serveur des runs)
WEBAPP_HOTE=utilisateur@serveur-des-runs
